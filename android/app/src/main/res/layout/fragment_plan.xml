<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Button
        android:id="@+id/btnGeneratePlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="Generar plan (próximas 4 semanas)"/>

    <TextView
        android:id="@+id/tvPlanEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay sesiones planificadas.\nPulsa el botón para generar un plan."
        android:gravity="center"
        android:textColor="#888888"
        android:padding="24dp"
        android:visibility="visible"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlanSessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp"/>

</LinearLayout>
